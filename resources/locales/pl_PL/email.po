msgid "Hello"
msgstr "Witaj"

msgid "We received a request to reset your TaskHub password. Click the link below to set a new password:"
msgstr "Otrzymaliśmy prośbę o zresetowanie hasła do TaskHub. Kliknij poniższy link, aby ustawić nowe hasło:"

msgid "Reset your password"
msgstr "Zresetuj swoje hasło"

msgid "If the button above does not work, copy and paste this link into your browser:"
msgstr "Jeśli powyższy przycisk nie działa, skopiuj i wklej ten link do przeglądarki:"

msgid "This link is valid for one hour"
msgstr "Ten link jest ważny przez godzinę"

msgid "If you did not request password reset, please ignore this message."
msgstr "Jeśli nie prosiłeś o zresetowanie hasła, zignoruj tę wiadomość."

msgid "Password reset"
msgstr "Resetowanie hasła"

msgid "Confirm your email"
msgstr "Potwierdź swój adres e-mail"

msgid "Thank you for registering at TaskHub. Click the link below to confirm your email address and activate your account:"
msgstr "Dziękujemy za rejestrację w TaskHub. Kliknij poniższy link, aby potwierdzić swój adres e-mail i aktywować konto:"

msgid "This link is valid for {0} hours"
msgstr "Ten link jest ważny przez {0} godz."

msgid "If you did not create a TaskHub account, please ignore this message."
msgstr "Jeśli nie zakładałeś konta w TaskHub, zignoruj tę wiadomość."
